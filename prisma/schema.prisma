generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum RoleName {
  CENTRAL_ADMIN
  SCHOOL_ADMIN
  STUDENT
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum Scope {
  GLOBAL
  SCHOOL
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TestStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  EXPIRED
}

enum GalleryType {
  PUBLIC
  SCHOOL
}

enum RegistrationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                   String                  @id @default(uuid()) @db.Uuid
  email                String?                 @unique
  username             String?                 @unique
  status               UserStatus              @default(ACTIVE)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  lastLoginAt          DateTime?
  roles                UserRole[]
  studentProfile       StudentProfile?
  adminAssignments     SchoolAdminAssignment[]
  createdMaterial      LearningMaterial[]      @relation("MaterialCreator")
  createdAssignments   Assignment[]            @relation("AssignmentCreator")
  createdTests         Test[]                  @relation("TestCreator")
  evaluatedSubmissions AssignmentSubmission[]  @relation("SubmissionEvaluator")
  galleryItems         GalleryItem[]
  auditLogs            AuditLog[]
}

model RegistrationRequest {
  id              String                   @id @default(uuid()) @db.Uuid
  authUserId      String                   @db.Uuid
  email           String
  fullName        String
  schoolCode      String
  academicYearName String
  admissionNumber String
  classLevel      Int
  streamId        String?                  @db.Uuid
  status          RegistrationRequestStatus @default(PENDING)
  reviewedById    String?                  @db.Uuid
  reviewedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([status, createdAt])
  @@index([schoolCode, academicYearName])
}

model Role {
  id    String     @id @default(uuid()) @db.Uuid
  name  RoleName   @unique
  users UserRole[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model School {
  id               String                  @id @default(uuid()) @db.Uuid
  schoolCode       String                  @unique
  name             String
  address          String?
  status           SchoolStatus            @default(ACTIVE)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  adminAssignments SchoolAdminAssignment[]
  enrollments      StudentEnrollment[]
  materials        LearningMaterial[]
  assignments      Assignment[]
  tests            Test[]
  galleries        Gallery[]
}

model SchoolAdminAssignment {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  schoolId  String    @db.Uuid
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  status    String
  user      User      @relation(fields: [userId], references: [id])
  school    School    @relation(fields: [schoolId], references: [id])

  @@index([schoolId, endedAt])
}

model StudentProfile {
  id          String                 @id @default(uuid()) @db.Uuid
  userId      String                 @unique @db.Uuid
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments StudentEnrollment[]
  submissions AssignmentSubmission[]
  attempts    TestAttempt[]
}

model AcademicYear {
  id          String              @id @default(uuid()) @db.Uuid
  name        String              @unique
  startDate   DateTime
  endDate     DateTime
  isCurrent   Boolean             @default(false)
  enrollments StudentEnrollment[]
}

model Stream {
  id                String                   @id @default(uuid()) @db.Uuid
  name              String                   @unique
  enrollments       StudentEnrollment[]
  materialStreams   LearningMaterialStream[]
  assignmentStreams AssignmentStream[]
  testStreams       TestStream[]
}

model StudentEnrollment {
  id              String           @id @default(uuid()) @db.Uuid
  studentId       String           @db.Uuid
  schoolId        String           @db.Uuid
  academicYearId  String           @db.Uuid
  admissionNumber String
  classLevel      Int
  streamId        String?          @db.Uuid
  status          EnrollmentStatus @default(ACTIVE)
  startedAt       DateTime         @default(now())
  endedAt         DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  student         StudentProfile   @relation(fields: [studentId], references: [id])
  school          School           @relation(fields: [schoolId], references: [id])
  academicYear    AcademicYear     @relation(fields: [academicYearId], references: [id])
  stream          Stream?          @relation(fields: [streamId], references: [id])

  @@unique([schoolId, academicYearId, admissionNumber])
  @@index([studentId, status])
}

model Subject {
  id          String             @id @default(uuid()) @db.Uuid
  name        String
  code        String             @unique
  status      ContentStatus      @default(PUBLISHED)
  materials   LearningMaterial[]
  assignments Assignment[]
  tests       Test[]
}

model LearningMaterial {
  id          String                   @id @default(uuid()) @db.Uuid
  title       String
  description String?
  subjectId   String                   @db.Uuid
  classLevel  Int
  scope       Scope
  schoolId    String?                  @db.Uuid
  createdById String                   @db.Uuid
  status      ContentStatus            @default(DRAFT)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  subject     Subject                  @relation(fields: [subjectId], references: [id])
  school      School?                  @relation(fields: [schoolId], references: [id])
  createdBy   User                     @relation("MaterialCreator", fields: [createdById], references: [id])
  streams     LearningMaterialStream[]
  files       LearningMaterialFile[]

  @@index([schoolId, classLevel, status])
}

model LearningMaterialStream {
  materialId String           @db.Uuid
  streamId   String           @db.Uuid
  material   LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  stream     Stream           @relation(fields: [streamId], references: [id])

  @@id([materialId, streamId])
}

model LearningMaterialFile {
  id           String           @id @default(uuid()) @db.Uuid
  materialId   String           @db.Uuid
  storagePath  String
  originalName String
  mimeType     String
  fileSize     Int
  createdAt    DateTime         @default(now())
  material     LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
}

model Assignment {
  id          String                 @id @default(uuid()) @db.Uuid
  title       String
  description String?
  subjectId   String                 @db.Uuid
  classLevel  Int
  scope       Scope
  schoolId    String?                @db.Uuid
  dueAt       DateTime
  createdById String                 @db.Uuid
  status      ContentStatus          @default(DRAFT)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  subject     Subject                @relation(fields: [subjectId], references: [id])
  school      School?                @relation(fields: [schoolId], references: [id])
  createdBy   User                   @relation("AssignmentCreator", fields: [createdById], references: [id])
  streams     AssignmentStream[]
  submissions AssignmentSubmission[]
  files       AssignmentFile[]
}

model AssignmentStream {
  assignmentId String     @db.Uuid
  streamId     String     @db.Uuid
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  stream       Stream     @relation(fields: [streamId], references: [id])

  @@id([assignmentId, streamId])
}

model AssignmentFile {
  id           String     @id @default(uuid()) @db.Uuid
  assignmentId String     @db.Uuid
  storagePath  String
  originalName String
  mimeType     String
  fileSize     Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
}

model AssignmentSubmission {
  id            String           @id @default(uuid()) @db.Uuid
  assignmentId  String           @db.Uuid
  studentId     String           @db.Uuid
  submittedAt   DateTime?
  isLate        Boolean          @default(false)
  status        String
  marks         Float?
  maxMarks      Float?
  feedback      String?
  evaluatedById String?          @db.Uuid
  evaluatedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  assignment    Assignment       @relation(fields: [assignmentId], references: [id])
  student       StudentProfile   @relation(fields: [studentId], references: [id])
  evaluatedBy   User?            @relation("SubmissionEvaluator", fields: [evaluatedById], references: [id])
  files         SubmissionFile[]

  @@unique([assignmentId, studentId])
}

model SubmissionFile {
  id           String               @id @default(uuid()) @db.Uuid
  submissionId String               @db.Uuid
  storagePath  String
  originalName String
  mimeType     String
  fileSize     Int
  submission   AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Test {
  id                 String        @id @default(uuid()) @db.Uuid
  title              String
  description        String?
  subjectId          String        @db.Uuid
  classLevel         Int
  scope              Scope
  schoolId           String?       @db.Uuid
  durationSeconds    Int
  startsAt           DateTime
  endsAt             DateTime
  randomizeQuestions Boolean       @default(true)
  randomizeOptions   Boolean       @default(true)
  questionCount      Int?
  createdById        String        @db.Uuid
  status             TestStatus    @default(DRAFT)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  subject            Subject       @relation(fields: [subjectId], references: [id])
  school             School?       @relation(fields: [schoolId], references: [id])
  createdBy          User          @relation("TestCreator", fields: [createdById], references: [id])
  streams            TestStream[]
  questions          Question[]
  attempts           TestAttempt[]
}

model TestStream {
  testId   String @db.Uuid
  streamId String @db.Uuid
  test     Test   @relation(fields: [testId], references: [id], onDelete: Cascade)
  stream   Stream @relation(fields: [streamId], references: [id])

  @@id([testId, streamId])
}

model Question {
  id               String            @id @default(uuid()) @db.Uuid
  testId           String            @db.Uuid
  text             String
  marks            Float             @default(1)
  position         Int
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  test             Test              @relation(fields: [testId], references: [id], onDelete: Cascade)
  options          QuestionOption[]
  attemptQuestions AttemptQuestion[]
  answers          StudentAnswer[]
}

model QuestionOption {
  id         String          @id @default(uuid()) @db.Uuid
  questionId String          @db.Uuid
  text       String
  position   Int
  isCorrect  Boolean
  question   Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers    StudentAnswer[]
}

model TestAttempt {
  id          String            @id @default(uuid()) @db.Uuid
  testId      String            @db.Uuid
  studentId   String            @db.Uuid
  startedAt   DateTime          @default(now())
  expiresAt   DateTime
  submittedAt DateTime?
  status      AttemptStatus     @default(IN_PROGRESS)
  marks       Float?
  maxMarks    Float?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  test        Test              @relation(fields: [testId], references: [id])
  student     StudentProfile    @relation(fields: [studentId], references: [id])
  questions   AttemptQuestion[]
  answers     StudentAnswer[]

  @@unique([testId, studentId])
}

model AttemptQuestion {
  attemptId    String      @db.Uuid
  questionId   String      @db.Uuid
  displayOrder Int
  attempt      TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question     Question    @relation(fields: [questionId], references: [id])

  @@id([attemptId, questionId])
}

model StudentAnswer {
  id               String          @id @default(uuid()) @db.Uuid
  attemptId        String          @db.Uuid
  questionId       String          @db.Uuid
  selectedOptionId String?         @db.Uuid
  answeredAt       DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  attempt          TestAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         Question        @relation(fields: [questionId], references: [id])
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id])

  @@unique([attemptId, questionId])
}

model Gallery {
  id          String        @id @default(uuid()) @db.Uuid
  type        GalleryType
  schoolId    String?       @db.Uuid
  title       String
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  school      School?       @relation(fields: [schoolId], references: [id])
  items       GalleryItem[]
}

model GalleryItem {
  id           String   @id @default(uuid()) @db.Uuid
  galleryId    String   @db.Uuid
  storagePath  String
  originalName String
  mimeType     String
  fileSize     Int
  caption      String?
  createdById  String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  gallery      Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  createdBy    User     @relation(fields: [createdById], references: [id])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String   @db.Uuid
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User     @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}
